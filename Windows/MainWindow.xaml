<Window x:Class="twenty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:twenty"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="twenty" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        StateChanged="MainWindow_StateChanged"
        Background="Transparent"
        Foreground="{DynamicResource Fg}"
        Icon="icon.ico">
    <Window.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="8,8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FgMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="14"/>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" CornerRadius="11"
                                    Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1" Margin="12,0,0,0">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Fg}"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF2E9E5B"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF2E9E5B"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        IconSource="pack://application:,,,/icon.ico"
                        ToolTipText="twenty - Timer App"
                        TrayMouseDoubleClick="NotifyIcon_DoubleClick"
                        TrayRightMouseUp="NotifyIcon_RightMouseUp"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="ShowMenuItem_Click" />
                    <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="TimerTextBlock" Text="20:00" FontSize="72" FontWeight="Bold"
                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="StartButton" Content="Start" Width="80" Margin="5" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="80" Margin="5" Click="StopButton_Click" IsEnabled="False"/>
                <Button x:Name="ResetButton" Content="Reset" Width="80" Margin="5" Click="ResetButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Settings overlay: covers the timer -->
        <Border x:Name="SettingsPanel" Visibility="Collapsed"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="14" Margin="30,30,30,60" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="WORK (MINUTES)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkTimeTextBox" Text="20" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BREAK (SECONDS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BreakTimeTextBox" Text="20" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="StartupCheckBox" Content="Start with Windows"
                          Style="{StaticResource SwitchBox}" Margin="0,22,0,0"
                          Click="StartupCheckBox_Click"/>
            </StackPanel>
        </Border>

        <Button Content="⏰" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0"
                Width="45" Height="45" FontSize="15" FontWeight="Bold"
                Background="Transparent" BorderBrush="Transparent"
                ToolTip="Settings" Click="SettingsButton_Click"/>
    </Grid>
</Window>
